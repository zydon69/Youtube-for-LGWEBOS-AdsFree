{
  "name": "youtube-webos",
  "version": "0.5.5",
  "description": "Ad-free YouTube app for webOS",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "webpack --mode=production",
    "build:dev": "webpack --mode=development",
    "package": "pnpm run qa && pnpm run sbom && node tools/package.js && pnpm run verify:package",
    "sbom": "node tools/gen-sbom.js",
    "verify:package": "node tools/verify-package.js",
    "deploy": "pnpm run verify:package && node tools/deploy.js",
    "inspect": "ares-inspect youtube.leanback.v4",
    "launch": "ares-launch youtube.leanback.v4",
    "manifest": "node tools/gen-manifest.cjs youtube.leanback.v4.manifest.json",
    "prepare": "husky",
    "test": "node --test",
    "test:bundle": "node tools/smoke-bundle.js",
    "test:compat": "es-check",
    "lint:eslint": "eslint --concurrency auto",
    "lint:tsc": "tsc -b",
    "lint:prettier": "prettier --check .",
    "lint:all": "pnpm run \"/^lint:(?!all)/\"",
    "qa": "pnpm run lint:all && pnpm test && pnpm run build && pnpm run test:bundle && pnpm run test:compat && pnpm audit"
  },
  "repository": "github:zydon69/Youtube-for-LGWEBOS-AdsFree",
  "license": "GPL-3.0-only",
  "bugs": "https://github.com/zydon69/Youtube-for-LGWEBOS-AdsFree/issues",
  "homepage": "https://github.com/zydon69/Youtube-for-LGWEBOS-AdsFree#readme",
  "dependencies": {
    "@babel/runtime-corejs3": "^7.29.2",
    "core-js-pure": "^3.50.0",
    "regenerator-runtime": "^0.14.1",
    "tiny-sha256": "^1.0.2",
    "whatwg-fetch": "^3.6.20"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/babel__core": "^7.20.5",
    "@types/babel__plugin-transform-runtime": "^7.9.5",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/node": "^25.6.0",
    "babel-loader": "^10.1.1",
    "babel-plugin-polyfill-corejs3": "^0.14.2",
    "babel-plugin-polyfill-regenerator": "^0.6.8",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "es-check": "^9.6.4",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-regexp": "^3.1.1",
    "globals": "^17.9.0",
    "happy-dom": "20.11.2",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.26",
    "postcss-load-config": "^6.0.1",
    "postcss-loader": "^8.2.1",
    "postcss-preset-env": "^11.3.2",
    "prettier": "^3.9.6",
    "style-loader": "^4.0.0",
    "tar": "^7.5.19",
    "terser-webpack-plugin": "^5.6.1",
    "transform-async-modules-webpack-plugin": "^1.1.1",
    "typescript": "^6.0.2",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "which-builtin-type": "^1.2.1"
  },
  "pnpm": {
    "overrides": {
      "@babel/plugin-transform-modules-systemjs": "7.29.4",
      "ajv@>=8.0.0 <8.18.0": "8.18.0",
      "brace-expansion@<1.1.18": "1.1.18",
      "brace-expansion@>=4.0.0 <5.0.9": "5.0.9",
      "fast-uri": "3.1.5",
      "flatted": "3.4.2",
      "js-yaml": "4.3.1",
      "nanoid@3": "3.3.17",
      "picomatch@2": "2.3.2",
      "picomatch@4": "4.0.4"
    }
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
